{
  "name": "aframe-dominoes",
  "description": "Dominos en réalité virtuelle (WebXR / A-Frame), multijoueur entre amis",
  "version": "1.3.0",
  "license": "MIT",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "cert": "openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj /CN=dominos-vr",
    "start:https": "SSL_KEY=key.pem SSL_CERT=cert.pem node server/index.js"
  },
  "keywords": [
    "aframe",
    "webxr",
    "vr",
    "dominoes",
    "multiplayer"
  ],
  "dependencies": {
    "aframe": "1.8.0",
    "ws": "^8.22.0"
  },
  "main": "server/index.js",
  "engines": {
    "node": ">=24.22.0"
  }
}
